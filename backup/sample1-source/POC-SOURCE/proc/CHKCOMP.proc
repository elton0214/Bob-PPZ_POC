//CHKCOMP  PROC MEMBER=
//*--------------------------------------------------------------*
//* PROC    : CHKCOMP - COMPILE COBOL/DB2 PROGRAM                 *
//*--------------------------------------------------------------*
//PC       EXEC PGM=DSNHPC,PARM='HOST(COB2),APOST'
//DBRMLIB  DD DISP=SHR,DSN=&SYSUID..CHK.DBRMLIB(&MEMBER)
//SYSIN    DD DISP=SHR,DSN=PROD.CHK.SRC(&MEMBER)
//SYSLIB   DD DISP=SHR,DSN=PROD.CHK.DCLGEN
//COB      EXEC PGM=IGYCRCTL,PARM='LIB,APOST,RENT,OPT(1)'
//SYSLIB   DD DISP=SHR,DSN=PROD.CHK.COPYLIB
//         DD DISP=SHR,DSN=PROD.COMMON.COPYLIB
//SYSLIN   DD DSN=&&LOADSET,DISP=(MOD,PASS),SPACE=(TRK,(3,3))
//LKED     EXEC PGM=IEWL,PARM='LIST,XREF'
//SYSLIN   DD DSN=&&LOADSET,DISP=(OLD,DELETE)
//SYSLMOD  DD DISP=SHR,DSN=PROD.CHK.LOADLIB(&MEMBER)
//         PEND
