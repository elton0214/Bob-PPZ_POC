//CHKEOD01 JOB (ACCT),'CHK EOD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*--------------------------------------------------------------*
//* JOB     : CHKEOD01 - CHECK DEPOSIT END-OF-DAY BATCH           *
//* STEP1   : PROCESS RETURNED CHECKS (CHKRTN01)                  *
//* STEP2   : DAILY RETURNED CHECK FEE REPORT (CHKRPT01)          *
//*--------------------------------------------------------------*
//JOBLIB   DD DISP=SHR,DSN=PROD.CHK.LOADLIB
//         DD DISP=SHR,DSN=DSNC10.SDSNLOAD
//STEP1    EXEC PGM=CHKRTN01
//RTNIN    DD DISP=SHR,DSN=TEST.CHK.RETURN.IN
//MASTER   DD DISP=SHR,DSN=CHK.MASTER.KSDS
//SYSOUT   DD SYSOUT=*
//STEP2    EXEC PGM=CHKRPT01,COND=(4,LT,STEP1)
//RPTOUT   DD DSN=TEST.CHK.RETURN.RPT,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),RECFM=FB,LRECL=80
//SYSOUT   DD SYSOUT=*
